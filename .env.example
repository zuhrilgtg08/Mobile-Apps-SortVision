# Contoh environment variables untuk mobile app SortVision.
# Salin ke `.env` dan sesuaikan. JANGAN commit `.env` dengan kredensial asli.
# Semua var yang dipakai di client HARUS berprefix EXPO_PUBLIC_ (di-inline saat build).

# Base URL REST API backend Laravel (default lihat src/services/api.ts).
# Contoh device fisik / LAN: http://192.168.1.10:8000/api
# | Menjalankan app dari	                             | URL broker  |
# | Browser web / iOS Simulator (broker di PC yang sama) | ws://127.0.0.1:9001 |
# | Android Emulator (broker di PC)	                     | ws://10.0.2.2:9001  |
# | HP fisik (Expo Go)                                   | ws://192.168.x.x:9001 ← IP LAN PC broker |
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# --- MQTT-over-WebSocket (OPSIONAL) ---
# Kalau dikosongkan, mobile app TIDAK mencoba connect MQTT dan hanya
# mengandalkan REST polling (baseline tetap jalan, tidak crash).
# EMQX default WS: ws://broker-host:8083/mqtt
# Mosquitto dengan listener websockets: ws://broker-host:9001
EXPO_PUBLIC_MQTT_WS_URL=ws://127.0.0.1:9001

# Prefix topik arm (samakan dengan MQTT_BASE_TOPIC backend). Default: arm
# Mobile hanya SUBSCRIBE ke <base>/status dan <base>/detection (read-only).
EXPO_PUBLIC_MQTT_BASE_TOPIC=arm

# Kredensial broker (opsional, isi kalau broker butuh auth).
EXPO_PUBLIC_MQTT_USERNAME=
EXPO_PUBLIC_MQTT_PASSWORD=
